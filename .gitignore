# Bytecode et caches d'outils
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environnements virtuels et artefacts d'installation
.venv/
venv/
*.egg-info/
build/
dist/

# Base locale produite par l'ingestion — reconstructible, jamais versionnée.
# Les fichiers -wal et -shm accompagnent le mode WAL de SQLite.
*.db
*.db-wal
*.db-shm
*.sqlite3

# Configuration propre à un poste ; voir config.exemple.toml.
# Ancré à la racine : sans le « / », le motif attraperait aussi
# .streamlit/config.toml, qui porte le thème de l'app et doit être versionné.
/config.toml
